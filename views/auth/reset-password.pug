extends ../layout

block content
  section.section.auth-section
    .auth-card
      h1 Reset Password

      if error
        .form-error #{error}
      if success
        .form-success #{success}

      form(method="POST", action=`/auth/reset-password/${token}`)
        input(type="hidden", name="_csrf", value=csrfToken)

        .form-group
          label(for="password") New Password
          input(type="password", id="password", name="password", required)

        .form-group
          label(for="passwordConfirm") Confirm Password
          input(type="password", id="passwordConfirm", name="passwordConfirm", required)

        button.btn.btn-primary.btn-block(type="submit") Reset Password

      .auth-links
        a(href="/auth/login") Back to Login
